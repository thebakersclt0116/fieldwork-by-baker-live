{
  "manifest_version": 3,
  "name": "Fieldwork by Baker Bridge",
  "version": "0.1.0",
  "description": "Read-only beta bridge that transfers a user's Ripley Total Hours view into Fieldwork by Baker after explicit user action.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "https://ripleyfieldworktracker.com/*",
    "https://*.ripleyfieldworktracker.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://fieldwork-by-baker-testing.vercel.app/*",
        "https://fieldworkbybaker.com/*",
        "https://www.fieldworkbybaker.com/*"
      ],
      "js": ["baker-content.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_title": "Fieldwork by Baker Bridge" }
}
